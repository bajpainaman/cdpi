#!/usr/bin/env bash
# Install the cdpi skill for Claude Code (~/.claude/skills/cdpi) and Codex/Amp (~/.agents/skills/cdpi).
# Override targets with CDPI_SKILL_DESTS="dir1 dir2". Then fetch the pinned sources once.
set -euo pipefail
SRC=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
for dest in ${CDPI_SKILL_DESTS:-"$HOME/.claude/skills/cdpi $HOME/.agents/skills/cdpi"}; do
  mkdir -p "$dest"
  for part in SKILL.md LICENSE sources.json bin lib data reference agents; do
    rm -rf "${dest:?}/$part"; cp -R "$SRC/$part" "$dest/$part"
  done
  find "$dest" -name __pycache__ -prune -exec rm -rf {} +
  echo "installed $dest"
done
"$SRC/bin/cdpi" sync
